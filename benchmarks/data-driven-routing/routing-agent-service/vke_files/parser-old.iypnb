    "## statistics, count, mean, var, std, min, max\n",
    "stats = df.describe(include='all')\n",
    "print(\"Statistics of the DataFrame:\")\n",
    "# stats to df\n",
    "stats_df = pd.DataFrame(stats)\n",
    "stats_df.to_csv(f\"{output_dir}/stats.csv\", index=True)\n",
    "display(stats_df)\n",
    "\n",
    "# plot time series of normalized metrics using mean and std.\n",
    "# target metrics: ttft, tpot, e2e_latency, prompt_tokens, output_tokens, total_tokens, kv_cache_hit_ratio, gpu_kv_cache_usage\n",
    "def create_time_series_plots(df):\n",
    "    metrics = ['prompt_tokens', 'output_tokens', 'total_tokens', 'numDecodeTokensForAllPods', 'numPrefillTokensForAllPods',\n",
    "        'selected_pod_kv_cache_hit_ratio', 'selected_pod_vllm_gpu_kv_cache_usage'\n",
    "    ]\n",
    "    plt.figure(figsize=(12, 6))\n",
    "    for metric in metrics:\n",
    "        if metric in df.columns:\n",
    "            plt.plot(df['normalized_start_time'], df[metric], label=metric)\n",
    "    plt.title(f'Time Series of {metric}')\n",
    "    plt.xlabel('Normalized Start Time (s)')\n",
    "    plt.ylabel(metric)\n",
    "    plt.legend()\n",
    "    plt.grid()\n",
    "    plt.savefig(f\"{output_dir}/time_series_plot.pdf\")\n",
    "    plt.show()\n",
    "    plt.close()\n",
    "create_time_series_plots(df)"
   ]
  },
