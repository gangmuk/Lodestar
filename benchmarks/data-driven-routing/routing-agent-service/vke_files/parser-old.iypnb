    "    if 'gateway_side_ttft' in df.columns and 'selected_pod_num_waiting_requests' in df.columns:\n",
    "        correlation_plots.append({\n",
    "            'x': 'selected_pod_num_waiting_requests',\n",
    "            'y': 'gateway_side_ttft',\n",
